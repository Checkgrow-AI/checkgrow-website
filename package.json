{
  "name": "checkgrow-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8030",
    "build": "node scripts/i18n/check.mjs && next build",
    "start": "next start -p 8030",
    "lint": "eslint",
    "i18n:check": "node scripts/i18n/check.mjs",
    "i18n:mockups": "node scripts/i18n/mockups.mjs",
    "i18n:layout": "node scripts/i18n/layout.mjs http://127.0.0.1:8030",
    "i18n:flow": "node scripts/i18n/flow.mjs http://127.0.0.1:8030",
    "test:team-orbit": "node --test tests/teamOrbit.test.mjs",
    "calendar:auth": "node --env-file=.env.local scripts/google-calendar-auth.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "geist": "^1.7.2",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "1.65.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
