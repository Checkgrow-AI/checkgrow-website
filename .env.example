# Public site origin, baked into canonical/sitemap/OG URLs at build time
NEXT_PUBLIC_SITE_URL=https://checkgrow.com

# Lead destination (Checkgrow user-waitlist webhook incl. its uwh_ token).
# REQUIRED in production; the form returns 503 without it.
WAITLIST_WEBHOOK_URL=

# Book-a-demo lead destination (Checkgrow leads-webhook incl. its whk_ token).
# Receives name, email, phone and every answer for each demo request.
DEMO_REQUEST_WEBHOOK_URL=
